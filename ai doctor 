    def process_input(self):
        user_text = self.user_input.get()
        if not user_text.strip():
            return
            
        self.user_input.delete(0, tk.END)
        self.add_to_chat(f"You: {user_text}")

        detected_condition = self.detect_condition(user_text)
        if detected_condition:
            self.handle_condition(detected_condition)
        else:
            response = "I need more details about your symptoms. Could you describe what you're experiencing in more detail? Or you can upload a medical report for analysis."
            self.add_to_chat("AI Doctor: " + response)
            self.speak_text(response)

    def detect_condition(self, text):
        text = text.lower()
        for condition in self.knowledge_base:
            if condition in text:
                return condition
        return None

    def handle_condition(self, condition):
        data = self.knowledge_base[condition]
        response = f"For {condition.capitalize()}:\n"
        response += "Medications:\n" + "\n".join([f"- {med}: {dose}" for med, dose in data['medicines'].items()])
        response += "\n\nHome Remedies:\n- " + "\n- ".join(data['remedies'])
        response += f"\n\nFollow-up: {data['followup']}"
        
        self.add_to_chat("AI Doctor: " + response)
        self.speak_text(f"I see you're experiencing {condition}. Let me provide some recommendations.")

    def upload_report(self):
        file_path = filedialog.askopenfilename(filetypes=[("Medical Reports", "*.pdf *.png *.jpg *.jpeg")])
        if not file_path:
            return
            
        self.add_to_chat(f"AI Doctor: Analyzing your medical report. Please wait...")
        self.speak_text("I'm analyzing your medical report. This may take a moment.")
        
        # Process the report in a separate thread to avoid freezing the UI
        threading.Thread(target=self._process_report, args=(file_path,), daemon=True).start()

    def _process_report(self, file_path):
        try:
            # Extract text from the report
            text = self._extract_text_from_report(file_path)
            
            # Simulate analysis (in a real app, this would use NLP/ML)
            self._analyze_report_text(text, os.path.basename(file_path))
            
            # Update UI with analysis results
            self.root.after(0, self._update_report_ui)
            
            # Notify user
            self.root.after(0, lambda: self.add_to_chat("AI Doctor: Report analysis complete. I've identified key findings and prepared recommendations."))
            self.root.after(0, lambda: self.speak_text("I've completed analyzing your medical report. Let's discuss the key findings."))
            
        except Exception as e:
            self.root.after(0, lambda: self.add_to_chat(f"AI Doctor: Error processing report: {str(e)}"))
            self.root.after(0, lambda: self.speak_text("I encountered an error while processing your report."))

    def _extract_text_from_report(self, file_path):
        # Handle different file types
        if file_path.lower().endswith('.pdf'):
            # Convert PDF to images
            pages = convert_from_path(file_path)
            text = ""
            for page in pages:
                text += pytesseract.image_to_string(page)
            return text
        elif file_path.lower().endswith(('.png', '.jpg', '.jpeg')):
            # Process image directly
            img = Image.open(file_path)
            return pytesseract.image_to_string(img)
        else:
            raise ValueError("Unsupported file format")

